{
	"compilerOptions": {
		"target": "es2023",
		"lib": ["es2023"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"declaration": true,
		"skipLibCheck": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"paths": {
			"llm-cache-pg": ["./src/index.ts"],
			"llm-cache-pg/openai": ["./src/openai.ts"]
		}
	},
	"include": ["src", "test", "examples", "*.config.ts"]
}
