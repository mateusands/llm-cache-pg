{
	"uid": "llm-cache-pg",
	"title": "llm-cache-pg",
	"tags": ["llm-cache-pg"],
	"timezone": "browser",
	"refresh": "10s",
	"time": {
		"from": "now-15m",
		"to": "now"
	},
	"schemaVersion": 41,
	"editable": true,
	"graphTooltip": 1,
	"templating": {
		"list": [
			{
				"name": "datasource",
				"label": "Data source",
				"type": "datasource",
				"query": "prometheus",
				"current": {},
				"hide": 0
			},
			{
				"name": "namespace",
				"label": "Namespace",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "${datasource}"
				},
				"query": {
					"query": "label_values(llm_cache_requests_total, namespace)",
					"refId": "ns"
				},
				"includeAll": true,
				"allValue": ".*",
				"multi": true,
				"current": {
					"text": "All",
					"value": "$__all"
				},
				"refresh": 2,
				"hide": 0,
				"description": "Only has values when prometheusHooks is created with namespaceLabel: true."
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"type": "stat",
			"title": "Hit ratio",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 6,
				"h": 5
			},
			"targets": [
				{
					"expr": "(sum(rate(llm_cache_requests_total{result=~\"exact_hit|semantic_hit\",namespace=~\"$namespace\"}[$__rate_interval])) or vector(0)) / (sum(rate(llm_cache_requests_total{result!=\"bypass\",namespace=~\"$namespace\"}[$__rate_interval])) > 0)",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit",
					"color": {
						"mode": "fixed",
						"fixedColor": "green"
					},
					"decimals": 1
				},
				"overrides": []
			},
			"options": {},
			"description": "Exact and semantic hits over lookups that could hit. Bypassed requests are left out."
		},
		{
			"id": 2,
			"type": "stat",
			"title": "Tokens saved",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 6,
				"y": 0,
				"w": 6,
				"h": 5
			},
			"targets": [
				{
					"expr": "round(sum(increase(llm_cache_tokens_saved_total[$__range])))",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "fixed",
						"fixedColor": "green"
					},
					"decimals": 0
				},
				"overrides": []
			},
			"options": {},
			"description": "Input and output tokens not spent in the selected range."
		},
		{
			"id": 3,
			"type": "stat",
			"title": "Cache errors",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 12,
				"y": 0,
				"w": 6,
				"h": 5
			},
			"targets": [
				{
					"expr": "round(sum(increase(llm_cache_errors_total[$__range]))) or vector(0)",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "fixed",
						"fixedColor": "green"
					},
					"decimals": 0
				},
				"overrides": []
			},
			"options": {},
			"description": "Failures inside the cache in the selected range. Those requests still reached the model."
		},
		{
			"id": 4,
			"type": "stat",
			"title": "Entries",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 18,
				"y": 0,
				"w": 6,
				"h": 5
			},
			"targets": [
				{
					"expr": "sum(llm_cache_entries)",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"color": {
						"mode": "fixed",
						"fixedColor": "green"
					},
					"decimals": 0
				},
				"overrides": []
			},
			"options": {},
			"description": "Rows in the cache tables, from Postgres statistics. Includes expired rows not yet pruned."
		},
		{
			"id": 5,
			"type": "timeseries",
			"title": "Requests by result",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 0,
				"y": 5,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "sum by (result) (rate(llm_cache_requests_total{namespace=~\"$namespace\"}[$__rate_interval]))",
					"legendFormat": "{{result}}",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "reqps"
				},
				"overrides": []
			},
			"options": {}
		},
		{
			"id": 6,
			"type": "timeseries",
			"title": "Lookup latency by stage",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 12,
				"y": 5,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "histogram_quantile(0.5, sum by (le, stage) (rate(llm_cache_lookup_duration_seconds_bucket[$__rate_interval])))",
					"legendFormat": "p50 {{stage}}",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				},
				{
					"expr": "histogram_quantile(0.95, sum by (le, stage) (rate(llm_cache_lookup_duration_seconds_bucket[$__rate_interval])))",
					"legendFormat": "p95 {{stage}}",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "B"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "s"
				},
				"overrides": []
			},
			"options": {}
		},
		{
			"id": 7,
			"type": "timeseries",
			"title": "Tokens saved per second",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 0,
				"y": 13,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "sum by (direction) (rate(llm_cache_tokens_saved_total[$__rate_interval]))",
					"legendFormat": "{{direction}}",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {}
		},
		{
			"id": 8,
			"type": "bargauge",
			"title": "Best similarity per semantic lookup",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 12,
				"y": 13,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "round(sum by (le) (increase(llm_cache_similarity_bucket[$__range])))",
					"format": "heatmap",
					"legendFormat": "{{le}}",
					"instant": true,
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"orientation": "vertical",
				"displayMode": "basic",
				"showUnfilled": false
			},
			"description": "How close the nearest stored question was, per lookup. Hits are the ones at or above the threshold."
		},
		{
			"id": 9,
			"type": "timeseries",
			"title": "Errors by stage",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 0,
				"y": 21,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "sum by (stage) (rate(llm_cache_errors_total[$__rate_interval]))",
					"legendFormat": "{{stage}}",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {}
		},
		{
			"id": 10,
			"type": "timeseries",
			"title": "Entries by table",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"x": 12,
				"y": 21,
				"w": 12,
				"h": 8
			},
			"targets": [
				{
					"expr": "sum by (table) (llm_cache_entries)",
					"legendFormat": "{{table}}",
					"datasource": {
						"type": "prometheus",
						"uid": "${datasource}"
					},
					"refId": "A"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {}
		}
	]
}
